APP_NAME=OpenModHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Plesk-managed local MariaDB / MySQL.
# Use 127.0.0.1 (TCP) instead of "localhost" so PDO does not try a socket
# that may not exist for the Plesk subscription user.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openmodhub
DB_USERNAME=openmodhub
DB_PASSWORD=change-me-to-a-strong-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave SESSION_DOMAIN empty unless you serve a wildcard subdomain.
# Plesk's "used" SSL certificate is per-domain, so a leading dot is rarely needed.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The queue worker is triggered by a Plesk scheduled task every 5 minutes
# (see docs/deployment-plesk.md, Step 9). Do NOT use "sync" on a public
# installation because it blocks requests while sending email and waiting
# on the VirusTotal API.
QUEUE_CONNECTION=database

CACHE_STORE=database

# ----- Mail (SMTP) -----
# Plesk's local Postfix can be used as a relay: MAIL_HOST=127.0.0.1
# Configure outbound SMTP in Plesk → Mail → Outgoing Mail if you prefer
# to send through a real provider.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----- Cloudflare Turnstile (optional) -----
# Without these, registration is still protected by CSRF, honeypot, minimum
# completion time, and IP rate limiting. Turnstile only activates after
# repeated failed registration attempts.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ----- VirusTotal (optional) -----
# Leave VIRUSTOTAL_ENABLED=false to disable the queued API checks. The
# user-provided VirusTotal link field is always available to mod authors.
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_POLL_DELAY_SECONDS=90

VITE_APP_NAME="${APP_NAME}"
